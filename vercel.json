{
  "version": 2,
  "builds": [
    {
      "src": "Frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "Backend/package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Backend/src/index.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "Backend/src/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "Frontend/$1",
      "check": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "Frontend/index.html"
    }
  ]
}